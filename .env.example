PORT=3000
# Confidential Twitch application. Register this exact redirect URI in Twitch:
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
TWITCH_REDIRECT_URI=http://localhost:3000/auth/twitch/callback
# Optional: preconfigure OBS instead of entering it in the app.
OBS_URL=ws://127.0.0.1:4455
OBS_PASSWORD=

# Optional: custom Chrome/Edge executable for HTML/CSS artwork rendering.
STREAMPICS_BROWSER=
